# ── World Cup Cards Backend - Variables de Entorno ──────
# Copiar a .env y ajustar valores

# Servidor
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Base de Datos
DB_HOST=localhost
DB_PORT=5432
DB_NAME=worldcup_cards
DB_USER=wcapp
DB_PASSWORD=wcapp_dev_password

# JWT
JWT_SECRET=ChangeThisSecretInProduction2026VeryLong
JWT_EXPIRATION=86400000

# CORS
CORS_ORIGINS=*
